        <!-- ==============================================================
             SECTION 7: HUMAN REVIEW (CỔNG 5)
             ============================================================== -->
        <section class="view-section" id="sec-review">
          <div class="card-enterprise" id="decisionGate5Card">
            <div class="card-header-row">
              <div class="card-title-group">
                <h2 class="card-title">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--warning)" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                  <span>Cổng 5: Verify Dữ Liệu & Phê Duyệt Quản Lý (Human-in-the-loop)</span>
                </h2>
                <span class="card-subtitle">Rà soát các trường hợp vượt thẩm quyền, xung đột địa lý hoặc thiếu thông tin cần bổ sung</span>
              </div>
              <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                <button type="button" class="btn-ai btn-ai-primary btn-ai-sm" onclick="handleManagerApprovalAll()">
                  <span>⚡ Duyệt Nhanh Toàn Bộ Hợp Lệ</span>
                </button>
                <button type="button" class="btn-ai btn-ai-outline btn-ai-sm" onclick="openFeedbackModal()">
                  <span>💬 Feedback & Tinh Chỉnh Trọng Số</span>
                </button>
              </div>
            </div>

            <!-- CỔNG 5 VERIFY GATE BANNER (Theo đúng sơ đồ luồng chuẩn: OK -> Bước 6 & 7; KHÔNG OK -> Feedback & vòng lại) -->
            <div id="verifyGateContainer" style="margin-bottom:20px;"></div>

            <!-- Escalations Container -->
            <div id="managerApprovalContainer" style="margin-bottom:20px;"></div>

            <!-- Feedback Loop Panel -->
            <div class="card-enterprise elevated" id="feedbackAdjustmentPanel">
              <h4 style="font-size:14px; font-weight:700; color:#FFFFFF; margin-bottom:8px;">Vòng Lặp Feedback & Điều Chỉnh Trực Tiếp</h4>
              <p style="font-size:12.5px; color:var(--text-secondary); margin-bottom:12px;">
                Nhập phản hồi hoặc yêu cầu điều chỉnh từ Trưởng phòng để AI Agent cập nhật ma trận phân loại & định tuyến:
              </p>
              <!-- 4 Gợi ý Feedback Nhanh Một Chạm -->
              <div style="display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap;">
                <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" onclick="applyFeedbackPreset('increaseBudget')">🎯 Tăng Điểm Ngân Sách (+15%)</button>
                <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" onclick="applyFeedbackPreset('balanceLoad')">⚖️ Tối Ưu Phân Bổ Quy Trình (SLA 4h)</button>
                <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" onclick="applyFeedbackPreset('strictTrap')">🛡️ Siết Chặt Bẫy Non-fit Lệch SP</button>
                <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" onclick="applyFeedbackPreset('looseAlias')">🔍 Gom Nhóm Tên Viết Tắt Alias</button>
              </div>
              <div style="display:flex; gap:10px;">
                <input type="text" class="ai-input" id="feedbackCustomInput" placeholder="Ví dụ: Tăng cường ưu tiên các ca giải pháp ERP cho ngành Cơ khí..." onkeydown="if(event.key==='Enter') handleFeedbackSubmit();" />
                <button type="button" class="btn-ai btn-ai-warning" id="btnSubmitFeedbackAndRerun" onclick="handleFeedbackSubmit()">
                  <span>Gửi Feedback & Chạy Lại</span>
                </button>
              </div>
              <div id="feedbackHistoryList" style="margin-top:14px;"></div>
            </div>
          </div>
        </section>

        <!-- ==============================================================
             SECTION 8: REPORTS & ANALYTICS
             ============================================================== -->
        <section class="view-section" id="sec-reports">
          <div class="card-enterprise">
            <div class="card-header-row">
              <div class="card-title-group">
                <h2 class="card-title">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
