                  </tr>
                  <tr>
                    <td><strong>Tập đoàn Cơ Khí Hà Nội</strong></td>
                    <td><span class="badge-priority p1">🔥 P1 Hot</span></td>
                    <td><span style="color:var(--danger); font-weight:700;">Hạn: 4 Giờ</span></td>
                    <td>Đội ngũ Kinh Doanh Miền Bắc</td>
                    <td>Gặp trực tiếp Giám đốc nhà máy, khảo sát dây chuyền</td>
                    <td><span class="badge-status warning">Đang chờ gọi</span></td>
                  </tr>
                  <tr>
                    <td><strong>Logistics Miền Trung</strong></td>
                    <td><span class="badge-priority p2">⚡ P2 Warm</span></td>
                    <td><span>Hạn: 24 Giờ</span></td>
                    <td>Đội ngũ Kinh Doanh Miền Trung</td>
                    <td>Gửi hồ sơ năng lực phần mềm WMS và báo giá sơ bộ</td>
                    <td><span class="badge-status info">Đã gửi email</span></td>
                  </tr>
                  <tr>
                    <td><strong>Dược Phẩm Nam Việt</strong></td>
                    <td><span class="badge-priority p2">⚡ P2 Warm</span></td>
                    <td><span>Hạn: 24 Giờ</span></td>
                    <td>Đội ngũ Kinh Doanh Miền Bắc</td>
                    <td>Đặt lịch demo online qua Zoom với Trưởng phòng CNTT</td>
