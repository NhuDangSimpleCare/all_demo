<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NAM VIỆT AI — B2B Lead Intelligence System</title>
  <!-- Google Fonts: Inter & Be Vietnam Pro -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      corePlugins: { preflight: false },
      theme: {
        extend: {
          colors: {
            appDark: '#080B14',
            surface: '#111827',
            surfaceElevated: '#172033',
            borderMain: '#263247',
            primaryIndigo: '#6366F1',
            aiPurple: '#8B5CF6',
            cyanAccent: '#22D3EE',
            successGreen: '#10B981',
            warningAmber: '#F59E0B',
            dangerRose: '#F43F5E'
          }
        }
      }
    }
  </script>
  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- SheetJS for Excel/CSV parsing -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <!-- App Stylesheet -->
  <link rel="stylesheet" href="styles.css" />
</head>
<body>

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="toast-container"></div>

  <!-- APPLICATION SHELL -->
  <div class="app-shell" id="appShell">

    <!-- ==================================================================
         SIDEBAR NAVIGATION
         ================================================================== -->
    <aside class="app-sidebar" id="appSidebar">
      <!-- Brand Header -->
      <div class="sidebar-header">
        <a href="javascript:void(0)" onclick="switchNavSection('sec-overview')" class="sidebar-brand-box">
          <div class="sidebar-brand-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
              <path d="M2 17l10 5 10-5"></path>
              <path d="M2 12l10 5 10-5"></path>
            </svg>
          </div>
          <div class="sidebar-brand-text">
            <div class="sidebar-brand-title">
              <span>NAM VIỆT AI</span>
              <span class="sidebar-brand-badge">SaaS V2.4</span>
            </div>
            <span class="sidebar-brand-sub">B2B Lead Intelligence</span>
          </div>
        </a>
        <button type="button" class="sidebar-collapse-btn" onclick="toggleSidebar()" title="Thu gọn / Mở rộng Sidebar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      </div>

      <!-- Navigation Items -->
      <nav class="sidebar-nav">
        <div class="sidebar-nav-group-title">QUẢN TRỊ ĐIỀU HÀNH</div>

        <div class="sidebar-nav-item active" id="navItemOverview" onclick="switchNavSection('sec-overview')" title="Tổng Quan & KPI">
          <div class="sidebar-nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
          </div>
          <span class="sidebar-nav-label">Tổng Quan & KPI</span>
        </div>

        <div class="sidebar-nav-item" id="navItemImport" onclick="switchNavSection('sec-import')" title="Nạp Dữ Liệu & Cổng 3">
          <div class="sidebar-nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
          </div>
          <span class="sidebar-nav-label">Nạp Dữ Liệu & Cổng 3</span>
          <span class="sidebar-nav-pill">Cổng 3</span>
        </div>

        <div class="sidebar-nav-item" id="navItemAgent" onclick="switchNavSection('sec-agent')" title="Quy Trình AI Agent (7 Bước)">
          <div class="sidebar-nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <span class="sidebar-nav-label">Quy Trình AI Agent</span>
          <span class="sidebar-nav-pill">7 Bước</span>
        </div>

        <div class="sidebar-nav-group-title">DỮ LIỆU & BÁN HÀNG</div>

        <div class="sidebar-nav-item" id="navItemCustomers" onclick="switchNavSection('sec-customers')" title="Khách Hàng (538 Golden Records)">
          <div class="sidebar-nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <span class="sidebar-nav-label">Khách Hàng (Golden Records)</span>
          <span class="sidebar-nav-pill" id="badgeGoldenCount">538</span>
        </div>

        <div class="sidebar-nav-item" id="navItemTasks" onclick="switchNavSection('sec-tasks')" title="Quản Lý Tác Vụ SLA CRM">
          <div class="sidebar-nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 11 12 14 22 4"></polyline>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
          </div>
          <span class="sidebar-nav-label">Quản Lý Tác Vụ SLA</span>
          <span class="sidebar-nav-pill warning">4h SLA</span>
        </div>

        <div class="sidebar-nav-group-title">KIỂM SOÁT & BÁO CÁO</div>

        <div class="sidebar-nav-item" id="navItemReview" onclick="switchNavSection('sec-review')" title="Human Review (Cổng 5 Phê Duyệt)">
          <div class="sidebar-nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <span class="sidebar-nav-label">Human Review (Cổng 5)</span>
          <span class="sidebar-nav-pill warning">Duyệt</span>
        </div>

        <div class="sidebar-nav-item" id="navItemReports" onclick="switchNavSection('sec-reports')" title="Báo Cáo Điều Hành & Xuất Bản">
          <div class="sidebar-nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <span class="sidebar-nav-label">Báo Cáo Điều Hành & Xuất</span>
        </div>

        <div class="sidebar-nav-item" id="navItemLogs" onclick="switchNavSection('sec-logs')" title="Nhật Ký Thực Thi (Audit Log)">
          <div class="sidebar-nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
          </div>
          <span class="sidebar-nav-label">Nhật Ký Thực Thi (Audit Log)</span>
        </div>
      </nav>

      <!-- Sidebar Status Footer -->
      <div class="sidebar-footer">
        <div class="sidebar-status-box">
          <div class="sidebar-status-indicator">
            <span class="status-dot-pulse"></span>
            <span>Hệ thống: <strong>Online</strong></span>
          </div>
          <span id="sidebarDatasetCount" style="color:var(--cyan); font-weight:700;">700 hồ sơ</span>
        </div>
        <div style="font-size:11px; color:var(--text-muted); display:flex; justify-content:space-between;">
          <span id="sidebarDatasetName">Nam Việt Leads</span>
          <span>Port 8080</span>
        </div>
      </div>
    </aside>

    <!-- ==================================================================
         MAIN CONTENT AREA
         ================================================================== -->
    <main class="app-main">
      <!-- TOPBAR -->
      <header class="app-topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-collapse-btn" onclick="toggleSidebar()" title="Đóng/Mở Sidebar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <div class="topbar-breadcrumbs">
            <a href="javascript:void(0)" onclick="switchNavSection('sec-overview')">Nam Việt AI</a>
            <span class="divider">/</span>
            <span class="current" id="topbarCurrentViewTitle">Tổng Quan & KPI</span>
          </div>
        </div>

        <div class="topbar-right">
          <!-- Live Status Badge -->
          <div class="topbar-status-badge" id="topbarStatusBadgeContainer">
            <span class="badge-dot" id="topbarStatusDot"></span>
            <span id="topbarAgentStatusText">AI Agent: Sẵn sàng</span>
          </div>

          <!-- Quick Action Buttons -->
          <button type="button" class="btn-ai btn-ai-outline btn-ai-sm" id="topbarDemoModeBtn" onclick="toggleDemoMode()" title="Khởi động / Thoát chế độ thuyết trình demo">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <span id="topbarDemoModeBtnText">Demo Mode</span>
          </button>

          <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" onclick="confirmResetModal()" title="Đặt lại trạng thái ban đầu có hộp thoại xác nhận">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M23 4v6h-6"></path>
              <path d="M1 20v-6h6"></path>
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
            <span>Reset</span>
          </button>

          <button type="button" class="btn-ai btn-ai-primary btn-ai-sm" id="topbarRunAgentBtn" onclick="triggerRunAiPipeline()" title="Kích hoạt toàn bộ quy trình AI Agent">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" id="topbarRunAgentIcon">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span id="topbarRunAgentText">Chạy AI Agent</span>
          </button>
        </div>
      </header>

      <!-- SCROLLABLE CANVAS -->
      <div class="app-canvas" id="appCanvas">

        <!-- ==============================================================
             SECTION 1: OVERVIEW & DASHBOARD
             ============================================================== -->
        <section class="view-section active" id="sec-overview">
          <!-- Hero Section -->
          <div class="hero-banner-card">
            <div class="hero-banner-content">
              <div>
                <div class="hero-badge-tag">
                  <span class="status-dot-pulse"></span>
                  <span>AI LEAD INTELLIGENCE SYSTEM</span>
                </div>
                <h1 class="hero-title">AI Lead Intelligence Dashboard</h1>
                <p class="hero-subtitle">
                  Transform fragmented customer data into actionable business intelligence. Hệ thống tự động hợp nhất thực thể doanh nghiệp, loại bỏ 162 cuộc gọi trùng lặp và phân hạng tiềm năng chính xác theo ICP.
                </p>
                <div class="hero-actions-row">
                  <button type="button" class="btn-ai btn-ai-primary" onclick="switchNavSection('sec-import')">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="17 8 12 3 7 8"></polyline>
                      <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    <span>Nạp Dữ Liệu Nguồn</span>
                  </button>

                  <button type="button" class="btn-ai btn-ai-secondary" onclick="triggerRunAiPipeline()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                    <span>Kích Hoạt AI Agent</span>
                  </button>

                  <button type="button" class="btn-ai btn-ai-outline" onclick="switchNavSection('sec-customers')">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                      <circle cx="9" cy="7" r="4"></circle>
                    </svg>
                    <span>Xem 538 Golden Records</span>
                  </button>
                </div>
              </div>

              <!-- Quick Meta Box -->
              <div style="background:rgba(17,24,39,0.7); border:1px solid var(--border-main); border-radius:var(--radius-md); padding:16px 20px; min-width:240px; display:flex; flex-direction:column; gap:8px;">
                <div style="font-size:11px; font-weight:700; color:var(--text-secondary); text-transform:uppercase;">TRẠNG THÁI MÔ HÌNH</div>
                <div style="font-size:14px; font-weight:800; color:#FFFFFF; display:flex; align-items:center; gap:8px;">
                  <span style="color:var(--success);">●</span> NamViet Rule + Heuristic
                </div>
                <div style="font-size:12px; color:var(--text-muted); border-top:1px solid #1E293B; padding-top:8px;">
                  Tốc độ xử lý: <strong style="color:var(--cyan);" id="headerProcSpeed">0.85s / 700 Leads</strong>
                </div>
                <div style="font-size:12px; color:var(--text-muted);">
                  Tỷ lệ làm sạch: <strong style="color:var(--success);">100%</strong>
                </div>
              </div>
            </div>
          </div>

          <!-- 6 KPI METRICS GRID -->
          <div class="kpi-grid-6">
            <div class="kpi-card accent-primary">
              <div class="kpi-card-header">
                <span class="kpi-card-label">Tổng Leads Đầu Vào</span>
                <div class="kpi-card-icon">⚡</div>
              </div>
              <div class="kpi-card-value" id="kpiBigRawVal">700</div>
              <div class="kpi-card-sub" id="kpiBigRawSub">Hội thảo, Web & Quảng cáo</div>
            </div>

            <div class="kpi-card accent-cyan">
              <div class="kpi-card-header">
                <span class="kpi-card-label">Golden Records Sạch</span>
                <div class="kpi-card-icon">💎</div>
              </div>
              <div class="kpi-card-value" id="kpiBigGolden">538</div>
              <div class="kpi-card-sub">Hồ sơ thực thể hợp nhất</div>
            </div>

            <div class="kpi-card accent-danger">
              <div class="kpi-card-header">
                <span class="kpi-card-label">Trùng Lặp Triệt Tiêu</span>
                <div class="kpi-card-icon">🛡️</div>
              </div>
              <div class="kpi-card-value" id="kpiCleanRemoved">162</div>
              <div class="kpi-card-sub">Tránh gọi trùng & xung đột</div>
            </div>

            <div class="kpi-card accent-warning">
              <div class="kpi-card-header">
                <span class="kpi-card-label">Thiếu Thông Tin</span>
                <div class="kpi-card-icon">⚠️</div>
              </div>
              <div class="kpi-card-value" id="kpiCleanEmptyCells">84</div>
              <div class="kpi-card-sub">Cần bổ sung qua vòng lặp AI</div>
            </div>

            <div class="kpi-card accent-purple">
              <div class="kpi-card-header">
                <span class="kpi-card-label">Lead Ưu Tiên Cao (P1)</span>
                <div class="kpi-card-icon">🔥</div>
              </div>
              <div class="kpi-card-value" id="kpiBigFit">204</div>
              <div class="kpi-card-sub">Cam kết SLA tiếp cận 4 giờ</div>
            </div>

            <div class="kpi-card accent-success">
              <div class="kpi-card-header">
                <span class="kpi-card-label">Sẵn Sàng Khai Thác</span>
                <div class="kpi-card-icon">🎯</div>
              </div>
              <div class="kpi-card-value" id="kpiBigAction">538</div>
              <div class="kpi-card-sub">Hồ sơ chuẩn hóa đã sẵn sàng</div>
            </div>
          </div>

          <!-- 6-STAGE PIPELINE VISUALIZATION -->
          <div class="pipeline-flow-container">
            <div class="card-header-row">
              <div class="card-title-group">
                <h3 class="card-title">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                  <span>Quy Trình Pipeline Thực Thi Của AI Agent</span>
                </h3>
                <span class="card-subtitle">Theo sát lưu đồ nghiệp vụ chuẩn hóa, kiểm soát Cổng 3 và Cổng 5 Feedback Loop</span>
              </div>
              <span class="badge-status success" id="currentStageBadge">● Đang ở Bước 1: Tiếp nhận dữ liệu</span>
            </div>

            <div class="pipeline-flow-track">
              <div class="pipeline-node active" id="wfNode1" onclick="switchNavSection('sec-import')">
                <div class="pipeline-node-circle" id="wfCircle1">1</div>
                <span class="pipeline-node-label">Nhập Dữ Liệu</span>
                <span class="pipeline-node-status">Excel/CSV thô</span>
              </div>
              <div class="pipeline-connector active"></div>

              <div class="pipeline-node" id="wfNode2" onclick="switchNavSection('sec-agent')">
                <div class="pipeline-node-circle" id="wfCircle2">2</div>
                <span class="pipeline-node-label">Cleaning</span>
                <span class="pipeline-node-status">Chuẩn hóa dữ liệu</span>
              </div>
              <div class="pipeline-connector"></div>

              <div class="pipeline-node" id="wfNodeGate3" onclick="switchNavSection('sec-import')">
                <div class="pipeline-node-circle" style="border-radius:4px; transform:rotate(45deg);"><span style="transform:rotate(-45deg);">3</span></div>
                <span class="pipeline-node-label">Cổng 3</span>
                <span class="pipeline-node-status">Đúng định dạng?</span>
              </div>
              <div class="pipeline-connector"></div>

              <div class="pipeline-node" id="wfNode4" onclick="switchNavSection('sec-agent')">
                <div class="pipeline-node-circle" id="wfCircle4">4</div>
                <span class="pipeline-node-label">Xử Lý AI Agent</span>
                <span class="pipeline-node-status">Scoring & Routing</span>
              </div>
              <div class="pipeline-connector"></div>

              <div class="pipeline-node" id="wfNodeGate5" onclick="switchNavSection('sec-review')">
                <div class="pipeline-node-circle" style="border-radius:4px; transform:rotate(45deg);"><span style="transform:rotate(-45deg);">5</span></div>
                <span class="pipeline-node-label">Cổng 5 Verify</span>
                <span class="pipeline-node-status">Human-in-the-loop</span>
              </div>
              <div class="pipeline-connector"></div>

              <div class="pipeline-node" id="wfNode6" onclick="switchNavSection('sec-customers')">
                <div class="pipeline-node-circle" id="wfCircle6">6</div>
                <span class="pipeline-node-label">Trả Lại Kết Quả</span>
                <span class="pipeline-node-status">Golden Records</span>
              </div>
              <div class="pipeline-connector"></div>

              <div class="pipeline-node" id="wfNode7" onclick="switchNavSection('sec-reports')">
                <div class="pipeline-node-circle" id="wfCircle7">7</div>
                <span class="pipeline-node-label">Báo Cáo & BI</span>
                <span class="pipeline-node-status">C-Level Export</span>
              </div>
            </div>
          </div>

          <!-- EXECUTIVE CHARTS ROW (DUAL SPLINE & DONUT) -->
          <div style="display:grid; grid-template-columns: 2fr 1fr; gap:20px; margin-bottom:24px;">
            <!-- Left Spline Chart -->
            <div class="card-enterprise">
              <div class="card-header-row">
                <div class="card-title-group">
                  <h3 class="card-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="2"><path d="M3 3v18h18"></path><path d="m19 9-5 5-4-4-3 3"></path></svg>
                    <span>Doanh Thu & Cơ Hội Dự Kiến Theo Thời Gian</span>
                  </h3>
                  <span class="card-subtitle">Mô hình dự báo doanh số trên 538 Golden Records</span>
                </div>
                <div style="display:flex; gap:6px;">
                  <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" id="btnPeriodDay" onclick="setChartPeriod('day')">Ngày</button>
                  <button type="button" class="btn-ai btn-ai-primary btn-ai-sm" id="btnPeriodWeek" onclick="setChartPeriod('week')">Tuần</button>
                  <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" id="btnPeriodMonth" onclick="setChartPeriod('month')">Tháng</button>
                </div>
              </div>

              <!-- Top Spline KPIs -->
              <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:12px; margin-bottom:16px;">
                <div style="background:var(--bg-surface-elevated); padding:10px 14px; border-radius:var(--radius-sm); border:1px solid var(--border-main);">
                  <div style="font-size:11px; color:var(--text-muted);">TỔNG DOANH THU KỲ VỌNG</div>
                  <div style="font-size:18px; font-weight:800; color:#FFFFFF;" id="kpiRevenueNum">14.8 Tỷ</div>
                  <div style="font-size:11px; color:var(--success);">+18.4% so với trước AI</div>
                </div>
                <div style="background:var(--bg-surface-elevated); padding:10px 14px; border-radius:var(--radius-sm); border:1px solid var(--border-main);">
                  <div style="font-size:11px; color:var(--text-muted);">SỐ CƠ HỘI HỢP LỆ</div>
                  <div style="font-size:18px; font-weight:800; color:var(--cyan);" id="kpiOrdersNum">538 Đơn</div>
                  <div style="font-size:11px; color:var(--text-secondary);">Sau loại 162 trùng</div>
                </div>
                <div style="background:var(--bg-surface-elevated); padding:10px 14px; border-radius:var(--radius-sm); border:1px solid var(--border-main);">
                  <div style="font-size:11px; color:var(--text-muted);">LỢI NHUẬN GỘP DỰ KIẾN</div>
                  <div style="font-size:18px; font-weight:800; color:var(--success);" id="kpiProfitNum">5.92 Tỷ</div>
                  <div style="font-size:11px; color:var(--text-secondary);">Biên 40% phần mềm</div>
                </div>
                <div style="background:var(--bg-surface-elevated); padding:10px 14px; border-radius:var(--radius-sm); border:1px solid var(--border-main);">
                  <div style="font-size:11px; color:var(--text-muted);">TIẾT KIỆM CHI PHÍ VẬN HÀNH</div>
                  <div style="font-size:18px; font-weight:800; color:var(--ai-accent);" id="kpiCostNum">32.4 Triệu</div>
                  <div style="font-size:11px; color:var(--success);">162 cuộc gọi trùng</div>
                </div>
              </div>

              <!-- SVG Spline Chart Container -->
              <div id="splineChartContainer" style="width:100%; height:260px; position:relative;"></div>
              <div id="splineXAxisContainer" style="display:flex; justify-content:space-between; font-size:11px; color:var(--text-muted); padding-top:8px;"></div>
              <div id="splineTooltip" style="display:none; position:absolute; background:#172033; border:1px solid var(--primary); padding:6px 12px; border-radius:6px; color:#fff; font-size:12px; pointer-events:none;"></div>
            </div>

            <!-- Right Donut Status Chart -->
            <div class="card-enterprise">
              <div class="card-header-row">
                <div class="card-title-group">
                  <h3 class="card-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ai-accent)" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <span>Phân Hạng Tiềm Năng (ICP)</span>
                  </h3>
                  <span class="card-subtitle">Tỷ lệ phân hạng theo mô hình 4 cấp</span>
                </div>
              </div>

              <!-- Donut Visual -->
              <div style="display:flex; justify-content:center; align-items:center; height:200px; position:relative;">
                <svg id="donutSvgElement" width="180" height="180" viewBox="0 0 100 100"></svg>
                <div style="position:absolute; text-align:center;">
                  <div style="font-size:24px; font-weight:900; color:#FFFFFF;" id="donutCenterPct">100%</div>
                  <div style="font-size:11px; color:var(--text-muted);" id="donutCenterSub">538 Leads</div>
                </div>
              </div>

              <!-- Donut Legend -->
              <div style="display:flex; flex-direction:column; gap:8px; margin-top:16px;">
                <div style="display:flex; justify-content:space-between; font-size:12px;">
                  <span style="display:flex; align-items:center; gap:6px;"><span style="width:8px; height:8px; border-radius:50%; background:#F43F5E;"></span> P1 Hot (Ưu tiên cao)</span>
                  <strong style="color:#FFFFFF;" id="legendCompleted">204 (38%)</strong>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:12px;">
                  <span style="display:flex; align-items:center; gap:6px;"><span style="width:8px; height:8px; border-radius:50%; background:#F59E0B;"></span> P2 Warm (Nuôi dưỡng)</span>
                  <strong style="color:#FFFFFF;" id="legendShipped">188 (35%)</strong>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:12px;">
                  <span style="display:flex; align-items:center; gap:6px;"><span style="width:8px; height:8px; border-radius:50%; background:#22D3EE;"></span> P3 Cold (Dài hạn)</span>
                  <strong style="color:#FFFFFF;" id="legendProcessing">108 (20%)</strong>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:12px;">
                  <span style="display:flex; align-items:center; gap:6px;"><span style="width:8px; height:8px; border-radius:50%; background:#64748B;"></span> P4 Non-fit (Loại trừ)</span>
                  <strong style="color:#FFFFFF;" id="legendCanceled">38 (7%)</strong>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ==============================================================
             SECTION 2: DATA IMPORT & CỔNG 3
             ============================================================== -->
        <section class="view-section" id="sec-import">
          <div class="card-enterprise">
            <!-- Header Row -->
            <div class="card-header-row" style="margin-bottom: 20px;">
              <div class="card-title-group">
                <h2 class="card-title" style="display: flex; align-items: center; gap: 10px;">
                  <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(34, 211, 238, 0.15); display: flex; align-items: center; justify-content: center; color: var(--cyan);">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                  </div>
                  <div>
                    <span style="font-size: 19px; font-weight: 800; color: #FFFFFF;">Cổng 3 · Universal Data Validation & Intelligent Schema Detection</span>
                    <span class="card-subtitle" style="display: block; font-size: 12.5px; color: var(--text-secondary); margin-top: 2px;">
                      Tiếp nhận đa lĩnh vực: Tự động phát hiện cấu trúc bảng, nhận diện Schema & Domain (Sales, HR, Finance, Marketing, B2B...)
                    </span>
                  </div>
                </h2>
              </div>
              <div style="display: flex; gap: 8px; align-items: center;">
                <span class="badge-status success" id="gate3StatusBadge">CỔNG 3: READY (UNIVERSAL MODE)</span>
              </div>
            </div>

            <!-- PHẦN 2: PROCESSING MODE SELECTOR (CHỌN CHẾ ĐỘ XỬ LÝ) -->
            <div style="margin-bottom: 22px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <label style="font-size: 13.5px; font-weight: 700; color: #E2E8F0; display: flex; align-items: center; gap: 6px;">
                  <span>⚙️ CHỌN CHẾ ĐỘ XỬ LÝ (PROCESSING MODE):</span>
                </label>
                <span style="font-size: 12px; color: var(--cyan); font-weight: 600;">Mặc định: Universal Data Intelligence</span>
              </div>
              <div class="mode-selector-grid">
                <!-- CARD 1: UNIVERSAL DATA INTELLIGENCE (DEFAULT) -->
                <div class="mode-card active" id="modeCardUniversal" onclick="setProcessingMode('UNIVERSAL')">
                  <div>
                    <div class="mode-card-header">
                      <div class="mode-card-title">
                        <span style="color: var(--cyan); font-size: 18px;">🌐</span>
                        <span>UNIVERSAL DATA INTELLIGENCE</span>
                      </div>
                      <span class="badge-status success" style="font-size: 10px; padding: 2px 6px;">MẶC ĐỊNH</span>
                    </div>
                    <div class="mode-card-desc">
                      Phân tích dữ liệu đa lĩnh vực. Tự động nhận diện cấu trúc, thống kê và không ép theo bất kỳ nghiệp vụ cố định nào.
                    </div>
                  </div>
                  <div class="mode-card-features">
                    <span class="mode-tag">✓ Không bắt buộc 12 trường</span>
                    <span class="mode-tag">✓ Bảo toàn 100% cột gốc</span>
                    <span class="mode-tag">✓ Thống kê số học & Tần suất</span>
                    <span class="mode-tag">✓ Hỗ trợ Sales, HR, Finance...</span>
                  </div>
                </div>

                <!-- CARD 2: B2B LEAD INTELLIGENCE -->
                <div class="mode-card" id="modeCardB2B" onclick="setProcessingMode('B2B')">
                  <div>
                    <div class="mode-card-header">
                      <div class="mode-card-title">
                        <span style="color: var(--primary); font-size: 18px;">🏢</span>
                        <span>B2B LEAD INTELLIGENCE</span>
                      </div>
                      <span class="badge-status info" style="font-size: 10px; padding: 2px 6px;">CHUYÊN SÂU NAM VIỆT</span>
                    </div>
                    <div class="mode-card-desc">
                      Phân tích dữ liệu khách hàng doanh nghiệp, chuẩn hóa Lead theo 12 trường và phân hạng tiềm năng ICP tự động.
                    </div>
                  </div>
                  <div class="mode-card-features">
                    <span class="mode-tag">✓ Ánh xạ 12 trường chuẩn</span>
                    <span class="mode-tag">✓ Lọc trùng Golden Record</span>
                    <span class="mode-tag">✓ Chấm điểm ICP (0-100)</span>
                    <span class="mode-tag">✓ Phân bổ SLA 15 phút</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- PHẦN 1: UPLOAD ZONE (KHU VỰC TẢI TỆP TRỰC TIẾP & KÉO THẢ) -->
            <div class="universal-upload-zone" id="universalDropZone">
              <input type="file" id="universalFileInput" accept=".csv,.xlsx,.xls,.json" style="display:none;" onchange="handleDirectFileUpload(this.files[0])" />
              <div style="font-size: 38px; margin-bottom: 8px;">📤</div>
              <h3 style="font-size: 17px; font-weight: 700; color: #F1F5F9; margin: 0 0 4px 0;">Upload Your Dataset</h3>
              <p style="font-size: 13px; color: var(--text-secondary); margin: 0 0 16px 0;">
                AI tự động nhận diện cấu trúc, phân loại lĩnh vực và phân tích dữ liệu của bạn.
              </p>
              <div style="display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px;">
                <button type="button" class="btn-ai btn-ai-primary" onclick="document.getElementById('universalFileInput').click()">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                  <span>Chọn Tệp Từ Máy Tính (Browse Files)</span>
                </button>
                <button type="button" class="btn-ai btn-ai-secondary" onclick="openDataImportModal()">
                  <span>📥 Nạp Qua Google Sheets</span>
                </button>
              </div>
              <div style="font-size: 11.5px; color: #94A3B8;">
                Hỗ trợ định dạng: <code style="color:var(--cyan);">.CSV</code>, <code style="color:var(--cyan);">.XLSX</code>, <code style="color:var(--cyan);">.XLS</code>, <code style="color:var(--cyan);">.JSON</code> · Dung lượng tối đa: 50MB
              </div>
            </div>

            <!-- QUICK TEST SUITE TOOLBAR (12 BỘ TEST ĐA DẠNG) -->
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 14px 16px; margin-bottom: 20px;">
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 10px;">
                <div style="font-size: 13px; font-weight: 700; color: #F1F5F9; display: flex; align-items: center; gap: 8px;">
                  <span>🧪 BỘ DỮ LIỆU KIỂM THỬ CỔNG 3 (AUTOMATED TEST SUITE):</span>
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                  <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" onclick="downloadExcelTemplate()" title="Tải xuống tệp Excel mẫu chuẩn 12 trường">
                    📊 Tải Mẫu Excel (.xlsx)
                  </button>
                  <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" onclick="downloadCsvTemplate()" title="Tải xuống tệp CSV UTF-8 mẫu chuẩn 12 trường">
                    📄 Tải Mẫu CSV (.csv)
                  </button>
                  <a href="/NamViet_DuLieuKhuyetThieu_TestDemo.csv" download="NamViet_DuLieuKhuyetThieu_TestDemo.csv" class="btn-ai btn-ai-secondary btn-ai-sm" style="text-decoration:none; font-size:11px;">
                    📥 Tải 25 Ca Khuyết Thiếu
                  </a>
                  <a href="/NamViet_DuLieuTho_TestDemo_ChuaXuLy.csv" download="NamViet_DuLieuTho_TestDemo_ChuaXuLy.csv" class="btn-ai btn-ai-secondary btn-ai-sm" style="text-decoration:none; font-size:11px;">
                    📥 Tải 30 Ca Test Thô
                  </a>
                </div>
              </div>

              <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                <select class="ai-select" id="testSuiteSelectBox" onchange="loadSelectedTestSuiteFile()" style="min-width: 320px; flex: 1;">
                  <optgroup label="── 1. Dữ liệu Đa Lĩnh Vực (Universal Datasets) ──">
                    <option value="test_02_sales_data.csv" selected>📊 TEST 2: Sales Data (order_id, product, quantity, revenue, region)</option>
                    <option value="test_03_hr_data.csv">👥 TEST 3: HR Data (employee_id, name, department, salary, hire_date)</option>
                    <option value="test_04_marketing_data.csv">🎯 TEST 4: Marketing Data (campaign_id, impressions, clicks, cost)</option>
                    <option value="test_05_finance_data.csv">💰 TEST 5: Finance Data (transaction_id, category, amount, account)</option>
                    <option value="test_09_unknown_dataset.csv">🌐 TEST 9: Unknown / General Dataset (feature_alpha, metric_gamma...)</option>
                    <option value="test_12_large_dataset.csv">⚡ TEST 12: Large Dataset (2,000 dòng kiểm thử hiệu năng)</option>
                  </optgroup>
                  <optgroup label="── 2. Dữ liệu Khách Hàng B2B Nam Việt ──">
                    <option value="test_01_b2b_lead.csv">🏢 TEST 1: B2B Lead Data (Đầy đủ 12 trường chuẩn B2B)</option>
                    <option value="NamViet_DuLieuKhuyetThieu_TestDemo.csv">⚠️ 25 Ca Khuyết Thiếu (Test Zero Hallucination)</option>
                    <option value="NamViet_DuLieuTho_TestDemo_ChuaXuLy.csv">🧪 30 Ca Test Thô (Bẫy, Trùng, Thiếu TT, Tranh chấp)</option>
                    <option value="leads700">🚀 Nam Việt 700 Leads (~700 hồ sơ SME tuần)</option>
                    <option value="leads20">⚡ Nam Việt 20 Ca Mẫu Cốt Lõi</option>
                  </optgroup>
                  <optgroup label="── 3. Ca Kiểm Thử Bẫy Lỗi (Edge Cases & Errors) ──">
                    <option value="test_06_empty_file.csv">🚫 TEST 6: Empty File (0 Byte File Test)</option>
                    <option value="test_07_header_only.csv">📄 TEST 7: Header Only (0 Data Rows Test)</option>
                    <option value="test_08_corrupted_file.csv">💥 TEST 8: Corrupted File (Tệp nhị phân hỏng)</option>
                    <option value="test_10_mixed_data_types.csv">🔀 TEST 10: Mixed Data Types (Cột lẫn lộn số và chữ)</option>
                    <option value="test_11_duplicate_data.csv">📑 TEST 11: Duplicate Data (Trùng lặp 100%)</option>
                  </optgroup>
                </select>

                <button type="button" class="btn-ai btn-ai-primary" onclick="loadSelectedTestSuiteFile()" style="font-weight: 700;">
                  <span>⚡ Nạp & Phân Tích Cổng 3</span>
                </button>
              </div>
            </div>

            <!-- PHẦN 5: VALIDATION RESULT BANNER (THÔNG BÁO KẾT QUẢ ĐA TẦNG) -->
            <div id="universalValidationBanner" style="margin-bottom: 20px;">
              <!-- Dynamic Banner populated by JS -->
            </div>

            <!-- PHẦN 3: AI SCHEMA DETECTION & DATA PROFILING CARD -->
            <div class="card-enterprise elevated" id="schemaDetectionSection" style="padding: 20px 22px; margin-bottom: 20px; border: 1px solid rgba(255,255,255,0.08); border-radius: 14px;">
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
                <div>
                  <h4 style="font-size: 16px; font-weight: 800; color: #FFFFFF; display: flex; align-items: center; gap: 8px; margin: 0 0 3px 0;">
                    <span>🔍 AI SCHEMA DETECTION & DATA PROFILING</span>
                  </h4>
                  <span style="font-size: 12.5px; color: var(--text-secondary);" id="schemaFileInfoText">
                    Tự động nhận diện cấu trúc và trích xuất dữ liệu đa trường.
                  </span>
                </div>
                <div id="detectedDomainBadgeContainer">
                  <span class="badge-status success" id="detectedDomainBadge" style="font-size: 12.5px; padding: 6px 12px;">
                    📊 Lĩnh Vực: Đang phân tích...
                  </span>
                </div>
              </div>

              <!-- 6 Metric KPI Counters -->
              <div class="schema-metric-grid">
                <div class="schema-metric-card">
                  <div class="schema-metric-val" id="schemaTotalRows" style="color:var(--cyan);">0</div>
                  <div class="schema-metric-lbl">Tổng số dòng (Rows)</div>
                </div>
                <div class="schema-metric-card">
                  <div class="schema-metric-val" id="schemaTotalCols" style="color:#A78BFA;">0</div>
                  <div class="schema-metric-lbl">Tổng số cột (Cols)</div>
                </div>
                <div class="schema-metric-card">
                  <div class="schema-metric-val" id="schemaCompleteness" style="color:var(--success);">100%</div>
                  <div class="schema-metric-lbl">Độ đầy đủ (Completeness)</div>
                </div>
                <div class="schema-metric-card">
                  <div class="schema-metric-val" id="schemaDuplicates" style="color:#FBBF24;">0</div>
                  <div class="schema-metric-lbl">Bản ghi trùng lặp</div>
                </div>
                <div class="schema-metric-card">
                  <div class="schema-metric-val" id="schemaTypeDist" style="font-size: 15px; color:#F1F5F9;">--</div>
                  <div class="schema-metric-lbl">Phân bổ kiểu dữ liệu</div>
                </div>
                <div class="schema-metric-card">
                  <div class="schema-metric-val" id="schemaQualityScore" style="color:var(--success);">95/100</div>
                  <div class="schema-metric-lbl">Điểm chất lượng (Data Score)</div>
                </div>
              </div>

              <!-- Domain Evidence & Quality Warnings -->
              <div id="schemaQualityIssuesContainer" style="margin-top: 10px;"></div>
            </div>

            <!-- PHẦN 4: INTELLIGENT COLUMN MAPPING TABLE -->
            <div class="card-enterprise elevated" id="columnMappingSection" style="padding: 20px 22px; margin-bottom: 20px; border: 1px solid rgba(255,255,255,0.08); border-radius: 14px;">
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 14px;">
                <div>
                  <h4 style="font-size: 15px; font-weight: 700; color: #F1F5F9; margin: 0 0 2px 0;">
                    BẢNG ÁNH XẠ Ý NGHĨA CỘT (INTELLIGENT COLUMN MAPPING)
                  </h4>
                  <p style="font-size: 12px; color: var(--text-secondary); margin: 0;">
                    AI tự động đề xuất ý nghĩa cho từng cột. Bạn có thể chỉnh sửa tên chuẩn hóa và kiểu dữ liệu trước khi phân tích.
                  </p>
                </div>
                <button type="button" class="btn-ai btn-ai-outline btn-ai-sm" onclick="resetToAutoMapping()">
                  <span>↺ Khôi Phục Tự Động</span>
                </button>
              </div>

              <div class="table-responsive-wrapper" style="max-height: 380px;">
                <table class="mapping-table" id="universalMappingTable">
                  <thead>
                    <tr>
                      <th style="width: 22%;">Tên Cột Gốc</th>
                      <th style="width: 25%;">Ý Nghĩa Đề Xuất (Semantic)</th>
                      <th style="width: 18%;">Kiểu Dữ Liệu</th>
                      <th style="width: 15%;">Mẫu Dữ Liệu</th>
                      <th style="width: 20%;">Độ Tin Cậy / Trạng Thái</th>
                    </tr>
                  </thead>
                  <tbody id="universalMappingTbody">
                    <!-- Populated by JS -->
                  </tbody>
                </table>
              </div>
            </div>

            <!-- PHẦN 6: ACTION BUTTONS TOOLBAR -->
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 22px;">
              <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <button type="button" class="btn-ai btn-ai-secondary" onclick="scrollToPreviewTable()">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  <span>Xem Trước Bảng Dữ Liệu (Preview)</span>
                </button>
                <button type="button" class="btn-ai btn-ai-outline" onclick="confirmSchemaMapping()">
                  <span>✓ Xác Nhận Cấu Trúc Schema</span>
                </button>
                <button type="button" class="btn-ai btn-ai-secondary" onclick="exportValidationReport()">
                  <span>📥 Xuất Báo Cáo Kiểm Định (JSON)</span>
                </button>
              </div>

              <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                <button type="button" class="btn-ai btn-ai-primary" id="btnRunAnalysisAction" onclick="triggerRunUniversalOrB2BAnalysis()" style="font-size: 14px; padding: 10px 20px; font-weight: 800;">
                  <span id="runAnalysisButtonText">🚀 Chạy Phân Tích Dữ Liệu (Universal) ➔</span>
                </button>
              </div>
            </div>

            <!-- PHẦN 7: UNIVERSAL ANALYTICS VIEW (CHỈ HIỂN THỊ KHI CHẾ ĐỘ UNIVERSAL HOẠT ĐỘNG) -->
            <div class="card-enterprise elevated" id="universalAnalyticsCard" style="padding: 20px 22px; margin-bottom: 24px; border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; display: none;">
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
                <div>
                  <h4 style="font-size: 16px; font-weight: 800; color: #FFFFFF; display: flex; align-items: center; gap: 8px; margin: 0 0 3px 0;">
                    <span>📊 TỔNG QUAN PHÂN TÍCH THỐNG KÊ (UNIVERSAL ANALYTICS)</span>
                  </h4>
                  <span style="font-size: 12.5px; color: var(--text-secondary);">
                    Thống kê tự động đa chiều cho các cột số học và danh mục mà không ép buộc theo nghiệp vụ B2B.
                  </span>
                </div>
                <span class="badge-status success" id="analyticsDomainBadge">PHÂN TÍCH ĐA NĂNG</span>
              </div>

              <!-- Thống kê số học -->
              <div style="margin-bottom: 18px;">
                <h5 style="font-size: 13.5px; font-weight: 700; color: var(--cyan); margin-bottom: 10px;">
                  1. Thống Kê Số Học Cốt Lõi (Numeric Metrics)
                </h5>
                <div class="table-responsive-wrapper">
                  <table class="mapping-table" id="analyticsNumericTable">
                    <thead>
                      <tr>
                        <th>Trường Dữ Liệu</th>
                        <th>Giá Trị Nhỏ Nhất (Min)</th>
                        <th>Giá Trị Lớn Nhất (Max)</th>
                        <th>Trung Bình (Avg)</th>
                        <th>Tổng Cộng (Sum)</th>
                      </tr>
                    </thead>
                    <tbody id="analyticsNumericTbody"></tbody>
                  </table>
                </div>
              </div>

              <!-- Thống kê phân loại danh mục -->
              <div>
                <h5 style="font-size: 13.5px; font-weight: 700; color: #A78BFA; margin-bottom: 10px;">
                  2. Phân Bổ Tần Suất Danh Mục Hàng Đầu (Top Categories)
                </h5>
                <div id="analyticsCategoryContainer" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px;"></div>
              </div>
            </div>

            <!-- ==============================================================
                 KHỐI: KIỂM TRA NGUỒN DỮ LIỆU (Bối cảnh doanh nghiệp & Trao đổi AI)
                 Thiết kế chuẩn xác đồng bộ Dark AI Enterprise Style
                 ============================================================== -->
            <div class="source-check-wrapper card-enterprise elevated" style="margin-bottom: 24px; padding: 24px 26px; border: 1px solid rgba(255,255,255,0.08); border-radius: 14px;">
              <div style="margin-bottom: 18px;">
                <h3 style="font-size: 19px; font-weight: 700; color: #FFFFFF; display: flex; align-items: center; gap: 8px; margin: 0 0 4px 0;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                  <span>Kiểm tra nguồn dữ liệu</span>
                </h3>
                <p style="font-size: 13px; color: var(--text-secondary); margin: 0;">
                  Kiểm tra bối cảnh, từng bảng và cách đọc tiêu đề trước khi làm sạch.
                </p>
              </div>

              <!-- CARD 1: Bối cảnh doanh nghiệp -->
              <div class="card-enterprise source-check-subcard" style="background: #0E1526; border: 1px solid var(--border-main); border-radius: 12px; padding: 20px 22px; margin-bottom: 18px;">
                <div style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 18px;">
                  <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); display: flex; align-items: center; justify-content: center; color: #34D399; flex-shrink: 0; margin-top: 2px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                  </div>
                  <div>
                    <h4 style="font-size: 15px; font-weight: 700; color: #FFFFFF; margin: 0 0 3px 0;">Bối cảnh doanh nghiệp</h4>
                    <p style="font-size: 12.5px; color: var(--text-secondary); margin: 0;">Câu hỏi của bạn định hướng việc chọn chỉ số và đọc kết quả.</p>
                  </div>
                </div>

                <!-- Trường 1: Loại hình doanh nghiệp -->
                <div style="margin-bottom: 16px;">
                  <label for="businessTypeInput" style="display: block; font-size: 12.5px; font-weight: 600; color: #E2E8F0; margin-bottom: 6px;">
                    Loại hình doanh nghiệp <span style="color: #EF4444;">*</span>
                  </label>
                  <input type="text" id="businessTypeInput" value="Bán lẻ đa kênh" style="background: #111827; border: 1.5px solid #10B981; border-radius: 8px; color: #F8FAFC; font-size: 13.5px; padding: 10px 14px; width: 100%; box-shadow: 0 0 0 1px rgba(16,185,129,0.25); outline: none; transition: border-color 0.2s;" />
                </div>

                <!-- Trường 2: Thông tin bổ sung -->
                <div style="margin-bottom: 16px;">
                  <label for="businessExtraInfo" style="display: block; font-size: 12.5px; font-weight: 600; color: #E2E8F0; margin-bottom: 6px;">
                    Thông tin bổ sung <span style="font-weight: normal; color: var(--text-muted); font-size: 11.5px;">· không bắt buộc</span>
                  </label>
                  <textarea id="businessExtraInfo" rows="2" placeholder="Ví dụ: Hai chi nhánh, đang đánh giá hiệu quả quý I" style="background: #111827; border: 1px solid #1E293B; border-radius: 8px; color: #F1F5F9; font-size: 13px; padding: 9px 12px; width: 100%; resize: vertical; outline: none;"></textarea>
                </div>

                <!-- Trường 3: Vấn đề cần phân tích -->
                <div>
                  <label for="businessQuestionsInput" style="display: block; font-size: 12.5px; font-weight: 600; color: #E2E8F0; margin-bottom: 6px;">
                    Vấn đề cần phân tích <span style="color: #EF4444;">*</span>
                  </label>
                  <textarea id="businessQuestionsInput" rows="3" style="background: #111827; border: 1px solid #1E293B; border-radius: 8px; color: #F1F5F9; font-size: 13px; line-height: 1.6; padding: 9px 12px; width: 100%; resize: vertical; outline: none;">Doanh thu theo kênh nào cao nhất?&#10;Chi phí theo chiến dịch nào cao nhất?</textarea>
                  <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 5px;">Nhập tối đa 8 câu hỏi, mỗi câu một dòng.</div>
                </div>
              </div>

              <!-- CARD 2: Trao đổi yêu cầu với AI -->
              <div class="card-enterprise source-check-subcard" style="background: #0E1526; border: 1px solid var(--border-main); border-radius: 12px; padding: 20px 22px;">
                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 14px;">
                  <div>
                    <h4 style="font-size: 15px; font-weight: 700; color: #FFFFFF; margin: 0 0 3px 0;">Trao đổi yêu cầu với AI</h4>
                    <p style="font-size: 12.5px; color: var(--text-secondary); margin: 0;">Xem cách AI hiểu yêu cầu và bổ sung thông tin trước khi phân tích.</p>
                  </div>
                  <button type="button" class="btn-ai btn-ai-outline btn-ai-sm scope-review-btn" onclick="reviewScopeWithAI()" style="font-size: 12.5px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; padding: 7px 15px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    <span>✧ Xem lại phạm vi</span>
                  </button>
                </div>

                <!-- Alert bar -->
                <div style="background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.35); border-left: 3.5px solid #F59E0B; padding: 10px 14px; border-radius: 6px; font-size: 12.5px; color: #FDE68A; margin-bottom: 18px;">
                  Nguồn đã thay đổi. Xem lại phạm vi với các cột mới trước khi tiếp tục.
                </div>

                <!-- Section: Tôi hiểu yêu cầu của bạn -->
                <div style="margin-bottom: 18px;">
                  <h5 style="font-size: 13.5px; font-weight: 700; color: #F1F5F9; margin: 0 0 6px 0;">Tôi hiểu yêu cầu của bạn</h5>
                  <p id="aiUnderstandText" style="font-size: 13px; color: #CBD5E1; line-height: 1.6; margin: 0;">
                    Bạn muốn phân tích Bán lẻ đa kênh qua 2 câu hỏi. Trọng tâm đầu tiên là “Doanh thu theo kênh nào cao nhất?”.
                  </p>
                </div>

                <!-- Section: Góc nhìn đề xuất bổ sung -->
                <div style="margin-bottom: 20px;">
                  <h5 style="font-size: 13.5px; font-weight: 700; color: #F1F5F9; margin: 0 0 8px 0;">Góc nhìn đề xuất bổ sung</h5>
                  <ul id="aiSuggestedPerspectives" style="margin: 0; padding-left: 18px; font-size: 13px; color: #CBD5E1; line-height: 1.6;">
                    <li>So sánh kỳ mới nhất với kỳ trước trên cùng phạm vi và xác định nhóm đóng góp vào thay đổi.</li>
                    <li>Xem thêm lợi nhuận hoặc biên lợi nhuận nếu doanh thu và chi phí cùng phạm vi, đơn vị và định nghĩa.</li>
                  </ul>
                </div>

                <!-- Section: Câu hỏi cần làm rõ -->
                <div>
                  <h5 style="font-size: 13.5px; font-weight: 700; color: #F1F5F9; margin: 0 0 12px 0;">Câu hỏi cần làm rõ</h5>

                  <!-- Q1 -->
                  <div style="margin-bottom: 14px;">
                    <label for="aiClarifyQ1" style="display: block; font-size: 12.5px; font-weight: 600; color: #E2E8F0; margin-bottom: 5px;">
                      Bạn muốn xem toàn bộ dữ liệu hay tập trung vào tháng hoặc quý nào?
                    </label>
                    <textarea id="aiClarifyQ1" rows="2" placeholder="Nhập câu trả lời nếu đã xác định" style="background: #111827; border: 1px solid #1E293B; border-radius: 8px; color: #F1F5F9; font-size: 12.5px; padding: 8px 12px; width: 100%; resize: vertical; outline: none;"></textarea>
                  </div>

                  <!-- Q2 -->
                  <div style="margin-bottom: 14px;">
                    <label for="aiClarifyQ2" style="display: block; font-size: 12.5px; font-weight: 600; color: #E2E8F0; margin-bottom: 5px;">
                      Bạn sẽ dùng báo cáo để ra quyết định gì và chỉ số nào cần ưu tiên?
                    </label>
                    <textarea id="aiClarifyQ2" rows="2" placeholder="Nhập câu trả lời nếu đã xác định" style="background: #111827; border: 1px solid #1E293B; border-radius: 8px; color: #F1F5F9; font-size: 12.5px; padding: 8px 12px; width: 100%; resize: vertical; outline: none;"></textarea>
                  </div>

                  <!-- Q3 -->
                  <div style="margin-bottom: 14px;">
                    <label for="aiClarifyQ3" style="display: block; font-size: 12.5px; font-weight: 600; color: #E2E8F0; margin-bottom: 5px;">
                      Bạn muốn so với kỳ trước, mục tiêu hay một nhóm cụ thể? Nếu có mục tiêu, giá trị và đơn vị là gì?
                    </label>
                    <textarea id="aiClarifyQ3" rows="2" placeholder="Nhập câu trả lời nếu đã xác định" style="background: #111827; border: 1px solid #1E293B; border-radius: 8px; color: #F1F5F9; font-size: 12.5px; padding: 8px 12px; width: 100%; resize: vertical; outline: none;"></textarea>
                  </div>

                  <!-- Q4 -->
                  <div style="margin-bottom: 8px;">
                    <label for="aiClarifyQ4" style="display: block; font-size: 12.5px; font-weight: 600; color: #E2E8F0; margin-bottom: 5px;">
                      Các bộ dữ liệu có cùng thời gian và đơn vị đo không? Nếu cần đối chiếu giữa các bộ, trường nào liên kết được chúng?
                    </label>
                    <textarea id="aiClarifyQ4" rows="2" placeholder="Nhập câu trả lời nếu đã xác định" style="background: #111827; border: 1px solid #1E293B; border-radius: 8px; color: #F1F5F9; font-size: 12.5px; padding: 8px 12px; width: 100%; resize: vertical; outline: none;"></textarea>
                  </div>

                  <div style="font-size: 12px; color: var(--text-muted); margin-top: 6px;">
                    Câu trả lời giúp xác định phạm vi phân tích.
                  </div>
                </div>
              </div>
            </div>

            <!-- Preview Data Table -->
            <div class="card-header-row" style="margin-bottom:12px;">
              <div class="card-title-group">
                <h3 class="card-title">
                  <span id="tablePreviewName">Nam Việt Leads 700</span>
                  <span class="preview-table-stats" id="tablePreviewStats" style="font-size:12px; font-weight:normal; color:var(--text-secondary); margin-left:8px;">700 dòng nguồn · 12 cột</span>
                </h3>
              </div>
              <div style="display:flex; align-items:center; gap:10px;">
                <label style="display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--text-secondary); cursor:pointer;">
                  <input type="checkbox" id="chkUseFirstRowHeader" checked />
                  <span>Dòng đầu là tiêu đề</span>
                </label>
              </div>
            </div>

            <div class="table-responsive-wrapper" style="max-height:480px;">
              <table class="table-enterprise" id="studioPreviewTable">
                <thead id="studioPreviewThead"></thead>
                <tbody id="studioPreviewTbody"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ==============================================================
             SECTION 3: AI AGENT PROCESSING CENTER
             ============================================================== -->
        <section class="view-section" id="sec-agent">
          <!-- Control Panel -->
          <div class="card-enterprise">
            <div class="card-header-row">
              <div class="card-title-group">
                <h2 class="card-title">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ai-accent)" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                  <span>Trung Tâm Điều Khiển AI Agent Pipeline</span>
                </h2>
                <span class="card-subtitle">Theo dõi luồng xử lý tự động 7 bước từ làm sạch, khử trùng, chấm điểm đến kịch bản khai thác</span>
              </div>
              <div style="display:flex; gap:10px;">
                <button type="button" class="btn-ai btn-ai-outline btn-ai-sm" onclick="openWeightModal()">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                  <span>Chỉnh Trọng Số Scoring</span>
                </button>
                <button type="button" class="btn-ai btn-ai-primary" onclick="triggerRunAiPipeline()">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                  <span>Chạy Toàn Bộ Pipeline</span>
                </button>
              </div>
            </div>

            <!-- 7 Processing Step Cards (Interactive Workflow Inspectors) -->
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:14px; margin-bottom:20px;">
              <div class="card-enterprise elevated step-card-clickable" onclick="openWorkflowStepModal(1)" title="Click để xem chi tiết Bước 1: Tiền Kiểm Định Cổng 3" style="padding:16px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                  <strong style="color:var(--cyan);">01 · Tiền Kiểm Định Cổng 3</strong>
                  <span class="badge-status success">Hoàn tất ➔</span>
                </div>
                <p style="font-size:12px; color:var(--text-secondary);">Kiểm tra 12 trường cấu trúc bắt buộc và encoding UTF-8.</p>
              </div>

              <div class="card-enterprise elevated step-card-clickable" onclick="openWorkflowStepModal(2)" title="Click để xem chi tiết Bước 2: Cleaning & Chuẩn Hóa" style="padding:16px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                  <strong style="color:var(--primary);">02 · Cleaning & Chuẩn Hóa</strong>
                  <span class="badge-status success">Hoàn tất ➔</span>
                </div>
                <p style="font-size:12px; color:var(--text-secondary);">Làm sạch SĐT 10 số, chuẩn hóa email, loại ký tự rác.</p>
              </div>

              <div class="card-enterprise elevated step-card-clickable" onclick="openWorkflowStepModal(3)" title="Click để xem chi tiết Bước 3: Khử Trùng Lặp Thực Thể" style="padding:16px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                  <strong style="color:var(--danger);">03 · Khử Trùng Lặp Thực Thể</strong>
                  <span class="badge-status success">162 Trùng ➔</span>
                </div>
                <p style="font-size:12px; color:var(--text-secondary);">Nhận diện cùng doanh nghiệp qua MST, Domain & Alias.</p>
              </div>

              <div class="card-enterprise elevated step-card-clickable" onclick="openWorkflowStepModal(4)" title="Click để xem chi tiết Bước 4: Tạo Golden Record" style="padding:16px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                  <strong style="color:var(--success);">04 · Tạo Golden Record</strong>
                  <span class="badge-status success">538 Sạch ➔</span>
                </div>
                <p style="font-size:12px; color:var(--text-secondary);">Hợp nhất thông tin tốt nhất vào 1 hồ sơ duy nhất.</p>
              </div>

              <div class="card-enterprise elevated step-card-clickable" onclick="openWorkflowStepModal(5)" title="Click để xem chi tiết Bước 5: Chấm Điểm ICP" style="padding:16px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                  <strong style="color:var(--ai-accent);">05 · Chấm Điểm P1-P4 (ICP)</strong>
                  <span class="badge-status success">204 Hot P1 ➔</span>
                </div>
                <p style="font-size:12px; color:var(--text-secondary);">Thuật toán 4 trọng số: Ngành, Quy mô, Ngân sách, Thẩm quyền.</p>
              </div>

              <div class="card-enterprise elevated step-card-clickable" onclick="openWorkflowStepModal(6)" title="Click để xem chi tiết Bước 6: Kiểm Định Cổng 5" style="padding:16px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                  <strong style="color:var(--warning);">06 · Kiểm Định Cổng 5</strong>
                  <span class="badge-status warning">Human Loop ➔</span>
                </div>
                <p style="font-size:12px; color:var(--text-secondary);">Rà soát ca VIP vượt trần và hồ sơ thiếu ngân sách.</p>
              </div>

              <div class="card-enterprise elevated step-card-clickable" onclick="openWorkflowStepModal(7)" title="Click để xem chi tiết Bước 7: Sinh Kịch Bản & Task Khai Thác" style="padding:16px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                  <strong style="color:var(--cyan);">07 · Sinh Kịch Bản & Task Khai Thác</strong>
                  <span class="badge-status success">Sẵn sàng ➔</span>
                </div>
                <p style="font-size:12px; color:var(--text-secondary);">Tạo kịch bản mở đầu cá nhân hóa và lịch trình khai thác thông minh.</p>
              </div>
            </div>

            <!-- Real-time Terminal Execution Trace -->
            <div class="terminal-window">
              <div class="terminal-header">
                <div class="terminal-title">
                  <span style="width:8px; height:8px; border-radius:50%; background:var(--success);"></span>
                  <span>AI EXECUTION TRACE TERMINAL (REAL-TIME ENGINE LOGS)</span>
                </div>
                <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" onclick="exportLogsJson()">Xuất Log JSON</button>
              </div>
              <div class="terminal-body" id="agentLiveTerminal">
                <div class="terminal-line"><span class="terminal-time">[10:00:01]</span> <span class="terminal-stage">[PipelineInit]</span> <span>Khởi tạo mô hình AI Agent Nam Việt...</span></div>
                <div class="terminal-line"><span class="terminal-time">[10:00:02]</span> <span class="terminal-stage">[DataIngestion]</span> <span>Tiếp nhận 700 hồ sơ khách hàng thô từ 3 kênh phân tán.</span></div>
                <div class="terminal-line"><span class="terminal-time">[10:00:03]</span> <span class="terminal-stage">[Gate3_Format]</span> <span>Kiểm tra định dạng cấu trúc Cổng 3: 12/12 cột hợp lệ ✓</span></div>
                <div class="terminal-line"><span class="terminal-time">[10:00:04]</span> <span class="terminal-stage">[EntityResolution]</span> <span>Phát hiện 162 hồ sơ trùng lặp (Alias/MST/Domain). Khử trùng hoàn tất.</span></div>
                <div class="terminal-line"><span class="terminal-time">[10:00:05]</span> <span class="terminal-stage">[GoldenRecord]</span> <span>Tạo thành công 538 Golden Records duy nhất.</span></div>
                <div class="terminal-line"><span class="terminal-time">[10:00:06]</span> <span class="terminal-stage">[LeadScoring]</span> <span>Phân loại: 204 Hot P1, 188 Warm P2, 108 Cold P3, 38 Non-fit P4.</span></div>
                <div class="terminal-line"><span class="terminal-time">[10:00:07]</span> <span class="terminal-stage">[OutreachPrep]</span> <span>Đã hoàn tất phân hạng và sẵn sàng kịch bản khai thác cho 538 khách hàng.</span></div>
              </div>
            </div>
          </div>
        </section>

        <!-- ==============================================================
             SECTION 4: CUSTOMER INTELLIGENCE (GOLDEN RECORDS)
             ============================================================== -->
        <section class="view-section" id="sec-customers">
          <div class="card-enterprise">
            <div class="card-header-row">
              <div class="card-title-group">
                <h2 class="card-title">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                  <span>Customer Intelligence — Danh Sách Golden Records</span>
                </h2>
                <span class="card-subtitle">Hồ sơ khách hàng doanh nghiệp hợp nhất, đã chấm điểm và phân loại hành động</span>
              </div>
              <div style="font-size:13px; color:var(--text-secondary);" id="scoringCountLabel">
                Hiển thị <strong>538</strong> Golden Records
              </div>
            </div>

            <!-- Search & Filters Toolbar -->
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px; flex-wrap:wrap;">
              <div class="search-input-wrapper">
                <input type="text" class="ai-input" id="leadSearchInput" placeholder="🔍 Tìm theo tên công ty, MST, người liên hệ, SĐT, email..." oninput="handleSearchLeads(this.value)" />
                <button type="button" id="btnClearLeadSearch" onclick="clearLeadSearch()" class="search-clear-btn" title="Xóa tìm kiếm">✕</button>
              </div>

              <select class="ai-select" id="stageFilterSelect" onchange="handlePriorityFilter(this.value)">
                <option value="ALL">Mọi Phân Hạng (P1 - P4)</option>
                <option value="P1">🔥 P1 Hot (Ưu tiên cao)</option>
                <option value="P2">⚡ P2 Warm (Nuôi dưỡng)</option>
                <option value="P3">❄️ P3 Cold (Dài hạn)</option>
                <option value="P4">🚫 P4 Non-fit (Loại trừ)</option>
              </select>

              <select class="ai-select" id="repFilterSelect" onchange="handleRepFilter(this.value)">
                <option value="ALL">Tất cả Nhóm Khai Thác</option>
                <option value="Trần Văn Tuấn">Khu vực Miền Bắc (Senior)</option>
                <option value="Lê Thị Hà">Khu vực Miền Bắc (Mid)</option>
                <option value="Nguyễn Hải Nam">Khu vực Miền Bắc (Junior)</option>
                <option value="Phạm Quốc Bảo">Khu vực Miền Trung (Senior)</option>
                <option value="Đỗ Ngọc Ánh">Khu vực Miền Trung (Mid)</option>
                <option value="Hoàng Gia Huy">Khu vực Miền Nam (Senior)</option>
                <option value="Vũ Thu Phương">Khu vực Miền Nam (Mid)</option>
                <option value="Bùi Đình Thịnh">Khu vực Miền Nam (Junior)</option>
              </select>

              <select class="ai-select" id="sortFilterSelect" onchange="handleSortChange(this.value)">
                <option value="score_desc">🔥 Điểm ICP cao nhất</option>
                <option value="score_asc">❄️ Điểm ICP thấp nhất</option>
                <option value="name_asc">🏢 Tên công ty (A-Z)</option>
                <option value="budget_desc">💰 Ngân sách cao nhất</option>
              </select>

              <select class="ai-select" id="pageSizeSelect" onchange="setScoringPageSize(this.value)">
                <option value="15">15 bản ghi / trang</option>
                <option value="25" selected>25 bản ghi / trang</option>
                <option value="50">50 bản ghi / trang</option>
                <option value="ALL">Tất cả bản ghi</option>
              </select>
            </div>

            <!-- Golden Records Table -->
            <div class="table-responsive-wrapper" style="max-height:560px;">
              <table class="table-enterprise">
                <thead>
                  <tr>
                    <th style="min-width:240px;">Doanh Nghiệp (Pháp Nhân & Alias)</th>
                    <th style="min-width:300px;">Người Đại Diện & Nhu Cầu</th>
                    <th style="min-width:180px;">Khớp Sản Phẩm (Fit)</th>
                    <th style="min-width:180px;">Điểm Số (ICP & SLA)</th>
                    <th style="min-width:200px;">Định Tuyến Khai Thác</th>
                    <th style="min-width:160px;">Trạng Thái & Thao Tác</th>
                  </tr>
                </thead>
                <tbody id="scoringTableBody"></tbody>
              </table>
            </div>

            <!-- Pagination Control Bar -->
            <div class="pagination-bar" id="scoringPaginationBar">
              <div style="font-size:12.5px; color:var(--text-secondary);" id="scoringPageSummary">
                Đang hiển thị 1 - 25 trong tổng số 538 Golden Records
              </div>
              <div class="pagination-btns" id="scoringPaginationBtns">
                <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" id="btnPageFirst" onclick="setScoringPage(1)" title="Trang đầu">⇤ Đầu</button>
                <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" id="btnPagePrev" onclick="changeScoringPage(-1)">❮ Trước</button>
                <span id="scoringCurrentPageNum" style="font-size:12.5px; font-weight:700; color:#FFFFFF; padding:0 8px;">Trang 1 / 22</span>
                <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" id="btnPageNext" onclick="changeScoringPage(1)">Sau ❯</button>
                <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" id="btnPageLast" onclick="setScoringPage('LAST')" title="Trang cuối">Cuối ⇥</button>
              </div>
            </div>
          </div>
        </section>

        <!-- ==============================================================
