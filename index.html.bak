        <!-- ==============================================================
             SECTION 6: TASK MANAGEMENT (SLA CRM)
             ============================================================== -->
        <section class="view-section" id="sec-tasks">
          <div class="card-enterprise">
            <div class="card-header-row">
              <div class="card-title-group">
                <h2 class="card-title">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--warning)" stroke-width="2.5"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                  <span>Quản Lý Tác Vụ CRM & Cam Kết SLA Tiếp Cận</span>
                </h2>
                <span class="card-subtitle">P1 Hot cam kết gọi trong 4 giờ · P2 Warm gửi tài liệu 24 giờ · P3 Cold chăm sóc tự động</span>
              </div>
              <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                <select class="ai-select" id="taskFilterStatus" onchange="filterTasks()">
                  <option value="ALL">Mọi trạng thái</option>
                  <option value="PENDING">Chờ xử lý</option>
                  <option value="COMPLETED">Đã hoàn thành</option>
                </select>
                <select class="ai-select" id="taskFilterPriority" onchange="filterTasks()">
