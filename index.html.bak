                    <th>Hành Động Khuyến Nghị Từ AI</th>
                    <th>Trạng Thái</th>
                  </tr>
                </thead>
                <tbody id="taskTableBody">
                  <tr>
                    <td><strong>CTCP May Sài Gòn</strong></td>
                    <td><span class="badge-priority p1">🔥 P1 Hot</span></td>
