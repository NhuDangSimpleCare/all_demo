  <!-- ==================================================================
       DEMO MODE GUIDED FLOATING BAR
       ================================================================== -->
  <div class="demo-mode-bar" id="demoModeBar" style="display:none;">
    <span class="demo-step-badge" id="demoStepBadge">BƯỚC 1/6</span>
    <span class="demo-step-title" id="demoStepTitle">1. Tổng Quan Bài Toán Nghiệp Vụ Nam Việt</span>
    <div style="display:flex; gap:8px;">
      <button type="button" class="btn-ai btn-ai-secondary btn-ai-sm" onclick="prevDemoStep()">❮ Trước</button>
      <button type="button" class="btn-ai btn-ai-primary btn-ai-sm" onclick="nextDemoStep()">Tiếp Theo ❯</button>
      <button type="button" class="btn-ai btn-ai-outline btn-ai-sm" onclick="exitDemoMode()">Thoát Demo</button>
    </div>
  </div>

  <!-- ==================================================================
       COMMON MODAL (DATA IMPORT, WEIGHTS, CUSTOMER DETAIL)
       ================================================================== -->
  <div class="ai-modal-overlay" id="commonModal">
    <div class="ai-modal-box">
      <div class="ai-modal-header">
        <h3 id="commonModalTitle" style="font-size:16px; font-weight:700; color:#FFFFFF;">Chi Tiết</h3>
        <button type="button" class="sidebar-collapse-btn" onclick="closeCommonModal()">✕</button>
      </div>
      <div class="ai-modal-body" id="commonModalBody"></div>
      <div class="ai-modal-footer">
        <button type="button" class="btn-ai btn-ai-secondary" onclick="closeCommonModal()">Đóng</button>
      </div>
    </div>
  </div>

  <!-- APPLICATION SCRIPTS -->
  <script src="universal_data_engine.js"></script>
  <script src="mock_data.js"></script>
  <script src="ai_engine.js"></script>
  <script src="app.js"></script>

  <script>
    // Initialize Lucide icons on load
    document.addEventListener("DOMContentLoaded", () => {
      if (window.lucide) lucide.createIcons();
    });

    // Navigation Router
    window.switchNavSection = function(sectionId) {
      document.querySelectorAll('.view-section').forEach(el => el.classList.remove('active'));
      const target = document.getElementById(sectionId);
      if (target) target.classList.add('active');

      if (sectionId === 'sec-reports' && typeof window.renderExecutiveReport === 'function') {
        window.renderExecutiveReport(window.AppState ? window.AppState.pipelineResult : null);
      }

      // Update sidebar active link
      document.querySelectorAll('.sidebar-nav-item').forEach(el => el.classList.remove('active'));
      const navMap = {
        'sec-overview': 'navItemOverview',
        'sec-import': 'navItemImport',
        'sec-agent': 'navItemAgent',
        'sec-customers': 'navItemCustomers',
        'sec-tasks': 'navItemTasks',
        'sec-review': 'navItemReview',
        'sec-reports': 'navItemReports',
        'sec-logs': 'navItemLogs'
      };
      const titleMap = {
        'sec-overview': 'Tổng Quan & KPI',
        'sec-import': 'Nạp Dữ Liệu & Cổng 3',
        'sec-agent': 'Quy Trình AI Agent',
        'sec-customers': 'Khách Hàng (Golden Records)',
        'sec-tasks': 'Quản Lý Tác Vụ SLA',
        'sec-review': 'Human Review (Cổng 5)',
        'sec-reports': 'Báo Cáo Điều Hành & Xuất Bản',
        'sec-logs': 'Nhật Ký Thực Thi (Audit Log)'
      };
      const navId = navMap[sectionId];
      if (navId && document.getElementById(navId)) {
        document.getElementById(navId).classList.add('active');
      }

      // Update topbar breadcrumb title
      const titleEl = document.getElementById('topbarCurrentViewTitle');
      if (titleEl) titleEl.textContent = titleMap[sectionId] || 'Hệ Thống';

      // Scroll canvas to top
      const canvas = document.getElementById('appCanvas');
      if (canvas) canvas.scrollTop = 0;
    };

    // Sidebar Toggle
    window.toggleSidebar = function() {
      const sb = document.getElementById('appSidebar');
      if (sb) sb.classList.toggle('collapsed');
    };

    // Modal Controls
    window.closeCommonModal = function() {
      const modal = document.getElementById('commonModal');
      if (modal) modal.classList.remove('open');
    };

    // Quick Trigger for AI Pipeline
    window.triggerRunAiPipeline = function() {
      const statusText = document.getElementById('topbarAgentStatusText');
      if (statusText) statusText.textContent = "AI Agent: Đang xử lý...";
      showToast("⚡ <strong>AI Agent đang xử lý toàn bộ quy trình 7 bước...</strong>");
      
      setTimeout(() => {
        if (typeof window.executePipeline === 'function') {
          window.executePipeline();
        }
        if (statusText) statusText.textContent = "AI Agent: Sẵn sàng (538 Golden Records)";
        showToast("✅ <strong>Xử lý hoàn tất!</strong> Đã tạo 538 Golden Records và hoàn tất quy trình phân tích.");
        switchNavSection('sec-customers');
      }, 500);
    };

    // Demo Mode Controller
    const demoSteps = [
      { id: 'sec-overview', title: '1. Tổng Quan Bài Toán Nghiệp Vụ Nam Việt', badge: 'BƯỚC 1/5' },
      { id: 'sec-import', title: '2. Nạp Dữ Liệu Thô 700 Leads & Kiểm Định Cổng 3', badge: 'BƯỚC 2/5' },
      { id: 'sec-agent', title: '3. Quy Trình Thực Thi AI Agent 7 Bước', badge: 'BƯỚC 3/5' },
      { id: 'sec-customers', title: '4. Khám Phá 538 Golden Records Đã Khử Trùng', badge: 'BƯỚC 4/5' },
      { id: 'sec-reports', title: '5. Báo Cáo Điều Hành & Cổng 5 Feedback Loop', badge: 'BƯỚC 5/5' }
    ];
    let currentDemoIndex = 0;

    window.startDemoMode = function() {
      currentDemoIndex = 0;
      const bar = document.getElementById('demoModeBar');
      if (bar) bar.style.display = 'flex';
      applyDemoStep();
      showToast("🚀 <strong>Đã kích hoạt Demo Mode!</strong> Sử dụng thanh điều hướng bên dưới để demo trước giảng viên.");
    };

    window.exitDemoMode = function() {
      const bar = document.getElementById('demoModeBar');
      if (bar) bar.style.display = 'none';
      showToast("Đã thoát chế độ Demo.");
    };

    window.nextDemoStep = function() {
      if (currentDemoIndex < demoSteps.length - 1) {
        currentDemoIndex++;
        applyDemoStep();
      } else {
        showToast("🎉 Đã hoàn thành toàn bộ kịch bản trình chiếu demo!");
      }
    };

    window.prevDemoStep = function() {
      if (currentDemoIndex > 0) {
        currentDemoIndex--;
        applyDemoStep();
      }
    };

    function applyDemoStep() {
      const step = demoSteps[currentDemoIndex];
      const badge = document.getElementById('demoStepBadge');
      const title = document.getElementById('demoStepTitle');
      if (badge) badge.textContent = step.badge;
      if (title) title.textContent = step.title;
      switchNavSection(step.id);
    }
  </script>
</body>
</html>
